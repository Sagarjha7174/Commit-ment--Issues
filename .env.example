# Frontend configuration (Vite). Never put secrets here: every VITE_* value is shipped to the browser.

# fixtures = offline snapshot of real engine output (public/fixtures); live = FastAPI backend.
VITE_DATA_MODE=fixtures

# Base URL of the FastAPI app. Leave empty to use the same origin (the dev server proxies /api and /llm).
VITE_API_BASE_URL=

# Dev server proxy target for /api and /llm when VITE_API_BASE_URL is empty.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
