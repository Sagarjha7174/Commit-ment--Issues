# Copy to .env (git-ignored) and fill in. Without any LLM key the app and tests use the deterministic template explainer.
EPC_API_KEY=
# LLM provider keys (any one is enough; tried in LLM_PROVIDERS order)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional settings
LLM_PROVIDERS=
LLM_MODEL=
LLM_PARSE_MODEL=
LLM_JUDGE_MODEL=
LLM_ENABLED=1
LLM_TIMEOUT_S=30
LLM_MAX_OUTPUT_TOKENS=4000
